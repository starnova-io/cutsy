# Hearth Island — PRODUCTION build-time config.
#
# Vite bakes every VITE_* var into the client bundle, so everything here is
# PUBLIC BY DESIGN. No server secrets, ever — a RevenueCat *secret* key must
# never ship in a client. `npm run build` loads this file automatically in
# production mode; `.env.production.local` (gitignored) can override any line.

# --- In-app purchases (RevenueCat) — LIVE iOS PUBLIC SDK key (appl_…) ---
# RevenueCat -> project "Hearth Island" -> Apps -> (App Store) -> Public API Key.
# With this set, purchases.ts billingConfigured() is true on iOS and the paywall
# runs real StoreKit purchases through RevenueCat.
VITE_REVENUECAT_IOS_KEY=appl_scKfhhnKfHzPoaOgDYOnuRMvtBo

# RevenueCat project : Hearth Island
# Bundle id          : io.starnova.hearth
# Entitlement        : premium              (hardcoded in src/native/purchases.ts)
# Packages           : $rc_monthly · $rc_annual · $rc_lifetime
# Store products     : io.starnova.hearth.pro.monthly / .yearly / .lifetime
