{
  "name": "hearth-island",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "ios": "npm run build && cap sync ios && cap open ios",
    "ios:run": "bash scripts/ios-run.sh",
    "android": "npm run build && cap sync android && cap open android",
    "assets": "npx @capacitor/assets generate --ios --android"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/core": "^6.2.2",
    "@capacitor/haptics": "^6.0.3",
    "@capacitor/splash-screen": "^6.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "0.128.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.2",
    "@capacitor/ios": "^6.2.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "0.128.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.0",
    "vite-plugin-singlefile": "^2.0.2"
  }
}
