# RevenueCat's PUBLIC iOS SDK key (RevenueCat -> Project -> API keys -> "appl_...").
# Public by design: it identifies the app and grants nothing. Copy this file to
# .env.local and fill it in — without it the app builds and runs fine, the
# paywall just previews (no real purchase) as it does on the web.
VITE_REVENUECAT_IOS_KEY=
